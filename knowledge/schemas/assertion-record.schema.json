{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/assertion-record.schema.json",
  "title": "Knowledge Base Assertion Record",
  "type": "object",
  "required": ["id", "domain_id", "record_type", "entity_id", "field", "value", "status", "basis_date", "observed_at", "source_id", "visibility", "agent", "created_at"],
  "properties": {
    "id": { "type": "string" },
    "assertion_id": { "type": "string" },
    "domain_id": { "type": "string" },
    "record_type": { "const": "assertion_record" },
    "entity_id": { "type": "string" },
    "field": { "type": "string" },
    "value": {},
    "unit": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["confirmed", "pending", "conflict", "deferred", "context_only", "rejected"]
    },
    "basis_date": { "type": "string" },
    "observed_at": { "type": "string" },
    "source_id": { "type": "string" },
    "source_path": { "type": "string" },
    "evidence_note": { "type": "string" },
    "visibility": {
      "type": "string",
      "enum": ["public_candidate", "private", "restricted", "unknown_license"]
    },
    "public_export_allowed": { "type": "boolean" },
    "agent": { "type": "string" },
    "created_at": { "type": "string" }
  },
  "additionalProperties": true
}
