{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/analysis-record.schema.json",
  "title": "Knowledge Base Analysis Record",
  "type": "object",
  "required": ["id", "domain_id", "record_type", "status", "basis_date", "observed_at", "source_id", "visibility", "agent", "created_at"],
  "properties": {
    "id": { "type": "string" },
    "domain_id": { "type": "string" },
    "record_type": { "const": "analysis_record" },
    "entity_id": { "type": "string" },
    "status": { "enum": ["confirmed", "pending", "conflict", "deferred", "context_only", "rejected"] },
    "basis_date": { "type": "string" },
    "observed_at": { "type": "string" },
    "source_id": { "type": "string" },
    "analysis_type": { "type": "string" },
    "summary": { "type": "string" },
    "input_assertion_ids": { "type": "array", "items": { "type": "string" } },
    "visibility": { "enum": ["public_candidate", "private", "restricted", "unknown_license"] },
    "agent": { "type": "string" },
    "created_at": { "type": "string" }
  },
  "additionalProperties": true
}
