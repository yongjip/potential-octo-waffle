# macOS / editor
.DS_Store
.AppleDouble
.LSOverride
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / package managers
node_modules/
.npm/
.pnpm-store/
.yarn/
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/sdks/
!.yarn/versions/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/

# Local scratch / generated previews
tmp/
.agent-locks/
.agent-tmp/
*.tmp
*.bak
*.orig

# Secrets and local env
.env
.env.*
!.env.example
*.pem
*.key

# Review-gated research/source data.
# Keep collaboration metadata tracked, but leave raw/normalized data for a later review.
data/*
!data/agents/
!data/agents/**

# Local-only source cache folders remain excluded if data is force-added later.
data/**/_scratch/
data/**/_tmp/
